        <mxCell id="e12" value="pixels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="upload" target="facedet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="same frozen CLIP,&lt;br&gt;on the crop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="clip" target="fvec">
          <mxGeometry relative="1" as="geometry" />
