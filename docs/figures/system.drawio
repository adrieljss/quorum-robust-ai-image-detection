<mxfile host="app.diagrams.net">
  <diagram name="Quorum system">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;How Quorum decides&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=26;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="400" height="44" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="📤&lt;br&gt;&lt;b&gt;Upload&lt;/b&gt;&lt;br&gt;any image" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;one server,&lt;br&gt;models already loaded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="&lt;b&gt;Shared image reader&lt;/b&gt;&lt;br&gt;a frozen, general-purpose&lt;br&gt;vision model &amp;#8212; used once,&lt;br&gt;feeding all three detectors" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="490" y="112" width="250" height="106" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Detector 1&lt;/b&gt;&lt;br&gt;the whole image&lt;br&gt;&lt;i&gt;&amp;#8220;was this generated?&amp;#8221;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="20" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Detector 2&lt;/b&gt;&lt;br&gt;an edited patch&lt;br&gt;&lt;i&gt;&amp;#8220;was part of it changed?&amp;#8221;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="130" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Detector 3&lt;/b&gt;&lt;br&gt;faces&lt;br&gt;&lt;i&gt;&amp;#8220;is this person real?&amp;#8221;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="240" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="max" value="&lt;b&gt;Highest&lt;br&gt;score wins&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1090" y="128" width="150" height="96" as="geometry" />
        </mxCell>
        <mxCell id="verdict" value="&lt;b&gt;AI or Real&lt;/b&gt;&lt;br&gt;one number,&lt;br&gt;one answer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1300" y="122" width="170" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n_max" value="Any &lt;b&gt;one&lt;/b&gt; detector is enough.&lt;br&gt;They never have to agree &amp;#8212; that is&lt;br&gt;the point, and the name." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1055" y="240" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="extras" value="&lt;b&gt;Also shown, never counted&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="490" y="340" width="750" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="each detector's&lt;br&gt;own score" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="380" width="170" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="a box drawn&lt;br&gt;around the face" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="170" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="what the file says&lt;br&gt;about itself&lt;br&gt;&lt;i&gt;(C2PA / camera)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="380" width="180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="texture and text&lt;br&gt;checks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="380" width="170" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n_extra" value="These help a person &lt;b&gt;judge&lt;/b&gt; the verdict.&lt;br&gt;None of them can &lt;b&gt;change&lt;/b&gt; it." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;align=left;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="490" y="468" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="claim1" value="&lt;b&gt;Two problems, not one&lt;/b&gt;&lt;br&gt;A fully AI image, and a real photo with an AI-edited patch.&lt;br&gt;A single detector scored &lt;b&gt;worse than a coin flip&lt;/b&gt; on the second &amp;#8212; an edited photo is &lt;i&gt;mostly real&lt;/i&gt;.&lt;br&gt;So we stopped asking one model both questions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="590" height="130" as="geometry" />
        </mxCell>
        <mxCell id="claim2" value="&lt;b&gt;Cheap to run, cheap to extend&lt;/b&gt;&lt;br&gt;The reader is shared and never retrained; each detector is a tiny layer on top.&lt;br&gt;Whole trained system: &lt;b&gt;305 KB&lt;/b&gt;. A new detector costs almost nothing to add." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="690" y="560" width="550" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="upload" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="web" target="reader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
