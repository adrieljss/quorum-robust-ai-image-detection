<mxfile host="app.diagrams.net">
  <diagram name="Quorum system">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Quorum &amp;#8212; system architecture&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;color:#666666'&gt;one frozen backbone &amp;#183; 2,310 trained parameters &amp;#183; one max()&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="660" height="58" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&amp;#10052;&amp;#65039; &lt;b&gt;FROZEN&lt;/b&gt; pretrained, never updated&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#128293; &lt;b&gt;TRAINED&lt;/b&gt; fitted by us, linear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="30" width="450" height="34" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="&lt;b&gt;Input image&lt;/b&gt;&lt;br&gt;any size / format" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="148" width="145" height="72" as="geometry" />
        </mxCell>
        <mxCell id="clip" value="&amp;#10052;&amp;#65039; &lt;b&gt;CLIP ViT-L-14-quickgelu&lt;/b&gt;&lt;br&gt;304M params &amp;#183; fp16&lt;br&gt;&lt;i&gt;never fine-tuned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eaf2fb;strokeColor=#6c8ebf;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="225" y="140" width="205" height="88" as="geometry" />
        </mxCell>
        <mxCell id="v" value="&lt;b&gt;v&lt;/b&gt;&lt;br&gt;768-d" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="154" width="85" height="60" as="geometry" />
        </mxCell>
        <mxCell id="facedet" value="&amp;#10052;&amp;#65039; &lt;b&gt;face_crop()&lt;/b&gt;&lt;br&gt;YuNet, on the PIXELS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eaf2fb;strokeColor=#6c8ebf;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="225" y="300" width="205" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fvec" value="&lt;b&gt;f&lt;/b&gt; = [CLIP(crop), log&amp;#8322;px]&lt;br&gt;&lt;b&gt;769-d&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="296" width="185" height="68" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&amp;#128293; &lt;b&gt;general&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;g&lt;/sub&gt; = w&amp;#183;v + b&lt;br&gt;769 params" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="92" width="180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="tam" value="&amp;#128293; &lt;b&gt;tampered&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;t&lt;/sub&gt; = 1.25(w&amp;#183;v + b)&lt;br&gt;769 params" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="186" width="180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="face" value="&amp;#128293; &lt;b&gt;face&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;f&lt;/sub&gt; = w&amp;#183;f + b&lt;br&gt;772 params" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="296" width="180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="zmax" value="&lt;b&gt;z = max(z&lt;sub&gt;g&lt;/sub&gt;, z&lt;sub&gt;t&lt;/sub&gt;)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="92" width="175" height="48" as="geometry" />
        </mxCell>
        <mxCell id="sig" value="&lt;b&gt;p = &amp;#963;(z &amp;#8722; 1.4448)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="158" width="175" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pred" value="&lt;b&gt;pred = max(p, p&lt;sub&gt;face&lt;/sub&gt;)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1055" y="122" width="195" height="52" as="geometry" />
        </mxCell>
        <mxCell id="verdict" value="&lt;b&gt;AI&lt;/b&gt; if pred &amp;#8805; 0.5&lt;br&gt;&lt;font style='font-size:10px'&gt;&amp;#8801; raw score &amp;#8805; 0.8092&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1300" y="120" width="175" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n_max" value="&lt;b&gt;max(), not a vote.&lt;/b&gt; Any ONE branch firing is enough &amp;#8212; the task is disjunctive:&lt;br&gt;an image is AI-touched if it is fully synthetic &lt;b&gt;or&lt;/b&gt; locally edited." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="830" y="218" width="430" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_face" value="the only branch built on &lt;b&gt;different features&lt;/b&gt;&lt;br&gt;(769-d, not the shared 768-d)" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="895" y="376" width="270" height="32" as="geometry" />
        </mxCell>
        <mxCell id="shown" value="&lt;b&gt;BUILT AND SHOWN IN THE DEMO &amp;#8212; never enters pred&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="442" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="spec" value="&amp;#128293; &lt;b&gt;spectral&lt;/b&gt;&lt;br&gt;8 FFT features &amp;#183; 9 params&lt;br&gt;0.6736 clean / 0.5471 worst" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="478" width="225" height="74" as="geometry" />
        </mxCell>
        <mxCell id="txtb" value="&amp;#128293; &lt;b&gt;text&lt;/b&gt;&lt;br&gt;CLIP on an OCR crop &amp;#183; 772 params&lt;br&gt;transfers 0.8083, worth +0.0022" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="285" y="478" width="245" height="74" as="geometry" />
        </mxCell>
        <mxCell id="prov" value="&lt;b&gt;provenance&lt;/b&gt;&lt;br&gt;C2PA / EXIF / XMP&lt;br&gt;&lt;i&gt;evidence, not inference&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="478" width="195" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;content type &amp;#183; reliability&lt;/b&gt;&lt;br&gt;face box &amp;#183; per-branch scores" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="765" y="478" width="215" height="74" as="geometry" />
        </mxCell>
        <mxCell id="cut" value="&lt;b&gt;BUILT, MEASURED, REJECTED&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1010" y="442" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="fusion" value="&lt;b&gt;fusion&lt;/b&gt; &amp;#8212; a learned combiner over 14 inputs&lt;br&gt;&lt;b&gt;0.8511&lt;/b&gt; against max()'s &lt;b&gt;0.8597&lt;/b&gt;. It reaches parity only by&lt;br&gt;becoming the general probe: it can match the headline &lt;b&gt;or&lt;/b&gt;&lt;br&gt;detect tampering, never both." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="478" width="480" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n_cut" value="&lt;b&gt;Six&lt;/b&gt; branches have lost their place in max(): spectral, per-generator specialists, an MLP head,&lt;br&gt;face-tampered, general-noise, modern-general. All six shared the 768-d features. The one that&lt;br&gt;won brought different ones." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="900" height="46" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;Two problems, not one.&lt;/b&gt; A fully AI image, and a real photograph with an AI-edited patch.&lt;br&gt;The general probe scores edited photos at &lt;b&gt;AUROC 0.37&lt;/b&gt; &amp;#8212; worse than chance, because an&lt;br&gt;edited photo is &lt;i&gt;globally authentic&lt;/i&gt;. It is not failing; it is answering the other question correctly.&lt;br&gt;So we stopped asking one model both." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="570" width="510" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="upload" target="clip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="clip" target="v">
          <mxGeometry relative="1" as="geometry" />
